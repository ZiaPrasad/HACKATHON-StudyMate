# StudyMate — environment variables (NAMES ONLY; fill in your own values, never commit .env)

# ---------- LOCAL / INDEPENDENT MODE ----------
# When BOTH of these are set, the app uses Supabase Auth + the Supabase
# database directly + the studymate-ai Edge Function (Groq) for the assistant.
# When they are absent, the app runs on the Base44 platform as before.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- HOSTED BASE44 MODE (current production) ----------
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=

# Optional: legacy SDK import handling in vite.config.js
BASE44_LEGACY_SDK_IMPORTS=false

# ---------- SUPABASE EDGE FUNCTION SECRETS (server-side only) ----------
# Do NOT put these in the frontend bundle. Set them with:
#   supabase secrets set GROQ_API_KEY=your-key
GROQ_API_KEY=
# Optional, default is llama-3.3-70b-versatile
GROQ_MODEL=